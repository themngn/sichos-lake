# SichOS override of Fedora's flatpak-exported desktop entry (normally at
# /var/lib/flatpak/exports/share/applications/dev.vencord.Vesktop.desktop) —
# adds --password-store=gnome-libsecret to Exec=. See im.riot.Riot.desktop
# in this same directory for the full explanation (same fix, same app
# family — Vesktop is Electron-based too).
[Desktop Entry]
Name=Vesktop
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=startvesktop --file-forwarding dev.vencord.Vesktop --password-store=gnome-libsecret @@u %U @@
Terminal=false
Type=Application
Icon=dev.vencord.Vesktop
StartupWMClass=vesktop
X-AppImage-Version=1.6.7
GenericName=Internet Messenger
Categories=Network;
Keywords=discord;vencord;electron;chat;
MimeType=x-scheme-handler/discord;
Comment=Vesktop is a custom Discord desktop app
X-Desktop-File-Install-Version=0.28
X-Flatpak=dev.vencord.Vesktop
